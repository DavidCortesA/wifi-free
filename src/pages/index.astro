---
// Cada línea del título se parte en letras para animarlas una por una
const lines = [
  { text: 'LA ÚNICA', size: 'sm' },
  { text: 'CONEXIÓN', size: 'xl' },
  { text: 'QUE NECESITAS ES', size: 'xs' },
  { text: 'JESÚS', size: 'xl' },
];

let i = 0;
const title = lines.map((line) => ({
  ...line,
  letters: Array.from(line.text).map((ch) => ({ ch, i: i++ })),
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3a43a" />
    <title>WiFi Gratis</title>
    <meta name="description" content="La única conexión que necesitas es Jesús." />
    <meta property="og:title" content="WiFi Gratis 📶" />
    <meta property="og:description" content="Escanea para conectarte." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Inter:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/jesus.webp" />
  </head>
  <body>
    <!-- Pantalla falsa de "conectando al WiFi" -->
    <div class="loader" id="loader" aria-live="polite">
      <svg class="wifi" viewBox="0 0 100 80" aria-hidden="true">
        <circle class="bar b0" cx="50" cy="70" r="6" />
        <path class="bar b1" d="M33 55 a24 24 0 0 1 34 0" />
        <path class="bar b2" d="M21 43 a41 41 0 0 1 58 0" />
        <path class="bar b3" d="M9 31 a58 58 0 0 1 82 0" />
      </svg>
      <p class="loader-net">WiFi_Gratis_5G</p>
      <p class="loader-status" id="status">Conectando…</p>
      <div class="progress"><span></span></div>
    </div>

    <main class="scene" id="scene">
      <div class="glow" aria-hidden="true"></div>
      <div class="rays" aria-hidden="true"></div>
      <div class="windows" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <div class="curtain left" aria-hidden="true"></div>
      <div class="curtain right" aria-hidden="true"></div>
      <div class="dust" id="dust" aria-hidden="true"></div>

      <div class="signal" aria-hidden="true">
        <svg viewBox="0 0 100 80">
          <circle cx="50" cy="70" r="6" />
          <path d="M33 55 a24 24 0 0 1 34 0" />
          <path d="M21 43 a41 41 0 0 1 58 0" />
          <path d="M9 31 a58 58 0 0 1 82 0" />
        </svg>
        <span>Señal ilimitada</span>
      </div>

      <h1 class="title" aria-label="La única conexión que necesitas es Jesús">
        {
          title.map((line) => (
            <span class={`line ${line.size}`} aria-hidden="true">
              {line.letters.map(({ ch, i }) =>
                ch === ' ' ? (
                  <span class="space">&nbsp;</span>
                ) : (
                  <span class="letter" style={`--i:${i}`}>{ch}</span>
                )
              )}
            </span>
          ))
        }
      </h1>

      <img class="jesus" src="/jesus.webp" alt="Jesús sonriendo y señalando hacia arriba" width="1080" height="760" />

      <button class="again" id="again" type="button">🙏 Volver a conectar</button>
    </main>

    <script>
      import confetti from 'canvas-confetti';

      const loader = document.getElementById('loader')!;
      const status = document.getElementById('status')!;
      const again = document.getElementById('again')!;
      const dust = document.getElementById('dust')!;
      const colors = ['#ffd36b', '#fff4d6', '#f39a2b', '#ffffff', '#e8b04a', '#ffb3c7', '#9fd8ff'];

      function celebrate() {
        // Explosión central
        confetti({ particleCount: 160, spread: 100, startVelocity: 55, origin: { y: 0.55 }, colors });
        // Cañones laterales durante ~2.5 s
        const end = Date.now() + 2500;
        (function frame() {
          confetti({ particleCount: 5, angle: 60, spread: 60, origin: { x: 0, y: 0.75 }, colors });
          confetti({ particleCount: 5, angle: 120, spread: 60, origin: { x: 1, y: 0.75 }, colors });
          if (Date.now() < end) requestAnimationFrame(frame);
        })();
      }

      function reveal() {
        status.textContent = '¡Conectado! ✅';
        loader.classList.add('done');
        setTimeout(() => {
          document.body.classList.add('go');
          celebrate();
        }, 450);
        setTimeout(() => loader.remove(), 1200);
      }

      // Partículas de luz flotando
      for (let n = 0; n < 26; n++) {
        const p = document.createElement('i');
        p.style.left = `${Math.random() * 100}%`;
        p.style.setProperty('--d', `${8 + Math.random() * 10}s`);
        p.style.setProperty('--delay', `${-Math.random() * 18}s`);
        p.style.setProperty('--s', `${2 + Math.random() * 4}px`);
        dust.appendChild(p);
      }

      setTimeout(() => (status.textContent = 'Verificando contraseña…'), 1100);
      setTimeout(reveal, 2400);

      again.addEventListener('click', () => {
        document.body.classList.remove('go');
        void document.body.offsetWidth; // reinicia las animaciones
        document.body.classList.add('go');
        celebrate();
      });

      // Confetti extra al tocar la pantalla
      document.getElementById('scene')!.addEventListener('pointerdown', (e) => {
        if ((e.target as HTMLElement).closest('button')) return;
        confetti({
          particleCount: 40,
          spread: 70,
          startVelocity: 30,
          origin: { x: e.clientX / innerWidth, y: e.clientY / innerHeight },
          colors,
        });
      });
    </script>

    <style is:global>
      :root {
        --brown: #4a2810;
        --brown-2: #6b3c16;
        --gold: #ffd36b;
      }
      * {
        box-sizing: border-box;
        margin: 0;
      }
      html,
      body {
        height: 100%;
      }
      body {
        background: #f2a038;
        color: var(--brown);
        font-family: 'Inter', system-ui, sans-serif;
        overflow: hidden;
        -webkit-tap-highlight-color: transparent;
      }

      /* ---------- Loader falso de WiFi ---------- */
      .loader {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 14px;
        background: #0f1115;
        color: #e9ecf2;
        transition: opacity 0.7s ease, transform 0.7s ease;
      }
      .loader.done {
        opacity: 0;
        transform: scale(1.08);
        pointer-events: none;
      }
      .wifi {
        width: 110px;
        fill: none;
        stroke: #3a3f4b;
        stroke-width: 8;
        stroke-linecap: round;
      }
      .wifi circle {
        fill: #3a3f4b;
        stroke: none;
      }
      .wifi .bar {
        animation: bar 1.2s infinite;
      }
      .wifi .b1 { animation-delay: 0.15s; }
      .wifi .b2 { animation-delay: 0.3s; }
      .wifi .b3 { animation-delay: 0.45s; }
      .loader.done .bar {
        animation: none;
        stroke: #4ade80;
        fill: none;
      }
      .loader.done circle.bar {
        fill: #4ade80;
      }
      @keyframes bar {
        0%, 100% { stroke: #3a3f4b; fill-opacity: 1; }
        40% { stroke: #9fc4ff; }
      }
      .wifi circle.bar {
        animation-name: dot;
      }
      @keyframes dot {
        0%, 100% { fill: #3a3f4b; }
        40% { fill: #9fc4ff; }
      }
      .loader-net {
        font-weight: 600;
        font-size: 1.15rem;
        letter-spacing: 0.02em;
      }
      .loader-status {
        font-size: 0.95rem;
        opacity: 0.7;
        min-height: 1.4em;
      }
      .progress {
        width: 180px;
        height: 4px;
        border-radius: 4px;
        background: #262a33;
        overflow: hidden;
      }
      .progress span {
        display: block;
        height: 100%;
        width: 100%;
        background: linear-gradient(90deg, #6aa8ff, #4ade80);
        transform-origin: left;
        animation: fill 2.3s cubic-bezier(0.6, 0, 0.3, 1) forwards;
      }
      @keyframes fill {
        from { transform: scaleX(0); }
        to { transform: scaleX(1); }
      }

      /* ---------- Escena ---------- */
      .scene {
        position: relative;
        height: 100dvh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        isolation: isolate;
        background:
          radial-gradient(ellipse 70% 55% at 50% 38%, #fff3c4 0%, #ffd27a 30%, transparent 70%),
          linear-gradient(180deg, #f6b24a 0%, #f2a038 45%, #e3801f 100%);
      }
      .glow {
        position: absolute;
        inset: -20%;
        z-index: -3;
        background: radial-gradient(circle at 50% 40%, rgba(255, 250, 225, 0.85), transparent 45%);
        animation: breathe 6s ease-in-out infinite;
      }
      @keyframes breathe {
        0%, 100% { opacity: 0.75; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.06); }
      }
      .rays {
        position: absolute;
        left: 50%;
        top: 38%;
        width: 220vmax;
        height: 220vmax;
        z-index: -3;
        translate: -50% -50%;
        background: repeating-conic-gradient(
          from 0deg,
          rgba(255, 245, 210, 0.22) 0deg 6deg,
          transparent 6deg 18deg
        );
        mask: radial-gradient(circle, #000 0%, transparent 55%);
        -webkit-mask: radial-gradient(circle, #000 0%, transparent 55%);
        animation: spin 80s linear infinite;
      }
      @keyframes spin {
        to { rotate: 360deg; }
      }
      /* Ventanales de luz al fondo, como en el cartel */
      .windows {
        position: absolute;
        inset: 6% 8% 30%;
        z-index: -2;
        display: flex;
        justify-content: space-between;
        gap: 6%;
        filter: blur(14px);
        opacity: 0.55;
      }
      .windows span {
        flex: 1;
        border-radius: 999px 999px 8px 8px;
        background: linear-gradient(180deg, #fffaf0, rgba(255, 236, 190, 0.2));
      }
      .windows span:nth-child(2),
      .windows span:nth-child(3) {
        margin-top: 8%;
        opacity: 0.8;
      }
      /* Cortinas doradas */
      .curtain {
        position: absolute;
        top: 30%;
        bottom: -5%;
        width: 26vw;
        max-width: 220px;
        z-index: 2;
        pointer-events: none;
        background: repeating-linear-gradient(
          90deg,
          #b8650c 0px,
          #f6b73c 14px,
          #ffd877 22px,
          #d98614 34px,
          #a85a08 44px
        );
        box-shadow: inset 0 0 40px rgba(90, 40, 0, 0.45);
        animation: sway 7s ease-in-out infinite;
      }
      .curtain.left {
        left: 0;
        border-top-right-radius: 100% 60%;
        transform-origin: top left;
        translate: -45% 0;
      }
      .curtain.right {
        right: 0;
        border-top-left-radius: 100% 60%;
        transform-origin: top right;
        translate: 45% 0;
        animation-delay: -3.5s;
      }
      @keyframes sway {
        0%, 100% { rotate: 0deg; }
        50% { rotate: 1.5deg; }
      }
      .dust {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
      }
      .dust i {
        position: absolute;
        bottom: -10px;
        width: var(--s);
        height: var(--s);
        border-radius: 50%;
        background: #fffbe8;
        box-shadow: 0 0 8px 2px rgba(255, 245, 200, 0.8);
        animation: rise var(--d) linear var(--delay) infinite;
      }
      @keyframes rise {
        0% { transform: translate(0, 0); opacity: 0; }
        10% { opacity: 0.9; }
        100% { transform: translate(30px, -105dvh); opacity: 0; }
      }

      /* ---------- Indicador de señal ---------- */
      .signal {
        position: absolute;
        top: max(14px, env(safe-area-inset-top));
        right: 16px;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px 6px 9px;
        border-radius: 999px;
        background: rgba(255, 250, 235, 0.55);
        backdrop-filter: blur(6px);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--brown);
        opacity: 0;
      }
      .signal svg {
        width: 20px;
        fill: none;
        stroke: var(--brown);
        stroke-width: 10;
        stroke-linecap: round;
      }
      .signal circle {
        fill: var(--brown);
        stroke: none;
      }
      .go .signal {
        animation: pop 0.6s 2.6s cubic-bezier(0.3, 1.6, 0.5, 1) forwards;
      }
      @keyframes pop {
        from { opacity: 0; transform: translateY(-10px) scale(0.8); }
        to { opacity: 1; transform: none; }
      }

      /* ---------- Título ---------- */
      .title {
        position: relative;
        z-index: 3;
        margin-top: max(9dvh, calc(env(safe-area-inset-top) + 48px));
        padding: 0 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: 'Cinzel', 'Trajan Pro', Georgia, serif;
        font-weight: 700;
        line-height: 0.95;
        text-align: center;
        color: var(--brown);
        text-shadow: 0 2px 0 rgba(255, 240, 200, 0.5), 0 8px 24px rgba(120, 60, 0, 0.25);
      }
      .line {
        display: block;
        white-space: nowrap;
      }
      .line.sm { font-size: clamp(1.7rem, 9vw, 4.2rem); }
      .line.xs { font-size: clamp(1rem, 5.2vw, 2.1rem); margin: 0.35em 0 0.15em; font-weight: 500; }
      .line.xl { font-size: clamp(2.6rem, 14.2vw, 7.5rem); font-weight: 900; }
      .letter {
        display: inline-block;
        opacity: 0;
      }
      .go .letter {
        animation: letter-in 0.75s cubic-bezier(0.2, 0.9, 0.25, 1.25) calc(var(--i) * 55ms) forwards;
      }
      /* JESÚS brilla después de aparecer */
      .go .line.xl:last-child .letter {
        animation:
          letter-in 0.75s cubic-bezier(0.2, 0.9, 0.25, 1.25) calc(var(--i) * 55ms) forwards,
          shine 2.8s ease-in-out calc(2.2s + var(--i) * 80ms) infinite;
      }
      @keyframes letter-in {
        0% { opacity: 0; transform: translateY(0.6em) rotateX(80deg) scale(0.6); filter: blur(8px); }
        100% { opacity: 1; transform: none; filter: blur(0); }
      }
      @keyframes shine {
        0%, 70%, 100% { color: var(--brown); text-shadow: 0 2px 0 rgba(255, 240, 200, 0.5), 0 8px 24px rgba(120, 60, 0, 0.25); }
        35% { color: #8a4c12; text-shadow: 0 0 18px #fff6d0, 0 0 40px #ffe08a; }
      }

      /* ---------- Jesús ---------- */
      .jesus {
        position: absolute;
        bottom: 0;
        left: 50%;
        z-index: 2;
        width: min(150vw, 62dvh * 1.42, 900px);
        max-width: none;
        height: auto;
        translate: -50% 0;
        opacity: 0;
        filter: drop-shadow(0 -6px 30px rgba(255, 240, 200, 0.55));
        user-select: none;
        -webkit-user-drag: none;
      }
      .go .jesus {
        animation: jesus-in 1.1s cubic-bezier(0.2, 0.9, 0.3, 1.1) 0.9s forwards;
      }
      @keyframes jesus-in {
        from { opacity: 0; transform: translateY(40%); }
        to { opacity: 1; transform: none; }
      }

      /* ---------- Botón ---------- */
      .again {
        position: absolute;
        bottom: max(18px, env(safe-area-inset-bottom));
        left: 50%;
        z-index: 4;
        translate: -50% 0;
        border: 0;
        border-radius: 999px;
        padding: 10px 20px;
        white-space: nowrap;
        font: 600 0.95rem 'Inter', system-ui, sans-serif;
        color: #fff8e6;
        background: linear-gradient(180deg, #7a4318, #4a2810);
        box-shadow: 0 6px 20px rgba(74, 40, 16, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        cursor: pointer;
        opacity: 0;
      }
      .again:active {
        scale: 0.96;
      }
      .go .again {
        animation: pop 0.6s 3.2s cubic-bezier(0.3, 1.6, 0.5, 1) forwards;
      }
    </style>
  </body>
</html>
